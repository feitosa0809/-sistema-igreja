# ==================================
# CONFIGURAÇÕES DO SERVIDOR
# ==================================
NODE_ENV=development
PORT=3000

# ==================================
# URL DO FRONTEND
# ==================================
FRONTEND_URL=http://localhost:3001

# ==================================
# SEGURANÇA - JWT
# ==================================
# IMPORTANTE: Gere uma chave secreta forte e única
# Você pode gerar uma usando: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=sua_chave_secreta_muito_segura_aqui_substitua_isso

# ==================================
# BANCO DE DADOS SQLITE
# ==================================
# O SQLite cria automaticamente o arquivo database.sqlite
# Não precisa de configurações adicionais
DB_PATH=./database.sqlite

# ==================================
# CONFIGURAÇÕES DE EMAIL (OPCIONAL)
# ==================================
# Configure estas opções através do painel de Configurações da Igreja
# Ou defina aqui para configuração padrão inicial:

# Email usado para enviar notificações
EMAIL_NOTIFICACAO=noreply@suaigreja.com

# Configurações SMTP (Exemplo com Gmail)
# Para Gmail: smtp.gmail.com, porta 587 ou 465
# Para Outlook: smtp.office365.com, porta 587
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu-email@gmail.com
SMTP_PASSWORD=sua-senha-de-aplicativo

# Se a porta for 465, use "true", senão "false"
SMTP_SECURE=false

# ==================================
# CONFIGURAÇÕES DE BACKUP
# ==================================
# Horas entre backups automáticos (padrão: 24 horas)
BACKUP_INTERVAL_HOURS=24

# Quantidade máxima de backups a manter
BACKUP_MAX_FILES=30

# ==================================
# OUTRAS CONFIGURAÇÕES
# ==================================
# Tamanho máximo de upload em MB
MAX_UPLOAD_SIZE=10

# Habilitar logs detalhados
DEBUG=false
